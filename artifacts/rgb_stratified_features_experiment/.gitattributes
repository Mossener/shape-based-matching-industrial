# Frozen hashes describe exact bytes, including the original line endings.
* -text whitespace=cr-at-eol,-blank-at-eof

# Generated records and retained upstream/source snapshots keep their bytes.
*.json whitespace=cr-at-eol,-trailing-space,-space-before-tab
*.txt whitespace=cr-at-eol,-trailing-space,-space-before-tab
*.stdout whitespace=cr-at-eol,-trailing-space,-space-before-tab
*.stderr whitespace=cr-at-eol,-trailing-space,-space-before-tab
control_v11/** whitespace=cr-at-eol,-trailing-space,-space-before-tab
frozen_helpers/** whitespace=cr-at-eol,-trailing-space,-space-before-tab
**/source/** whitespace=cr-at-eol,-trailing-space,-space-before-tab
**/sources/** whitespace=cr-at-eol,-trailing-space,-space-before-tab
